PORT=8000
DB_PATH=./bursa.db

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=your@gmail.com

# Telegram alerts
# Step 1: Message @BotFather on Telegram, send /newbot, follow prompts → get token
# Step 2: Start a chat with your new bot, then visit:
#         https://api.telegram.org/bot<TOKEN>/getUpdates
#         Look for "chat":{"id": ...} — that is your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often to fetch prices (minutes, default 15)
FETCH_INTERVAL_MINUTES=15
